<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>HomeRadar.Cdk</RootNamespace>
    <!-- The CDK runtime pins Microsoft.Extensions.Logging 9.x; the downgrade warning is expected here. -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.CDK.Lib" />
    <PackageReference Include="Constructs" />
  </ItemGroup>
</Project>
